mixin servicesItemIcon(name)
	span(class='services__item-icon', aria-hidden='true')
		if name === 'website'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				rect(x='3', y='4', width='18', height='13', rx='2', stroke='currentColor', stroke-width='1.75')
				path(d='M8 21 H16', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
				path(d='M12 17 V21', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
		else if name === 'cms'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				rect(x='5', y='3', width='14', height='18', rx='2', stroke='currentColor', stroke-width='1.75')
				path(d='M9 8 H15', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
				path(d='M9 12 H15', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
				path(d='M9 16 H13', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
		else if name === 'commerce'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				path(d='M6 8 L8 20 H16 L18 8 Z', stroke='currentColor', stroke-width='1.75', stroke-linejoin='round')
				path(d='M9 8 C9 6 10.3 4.5 12 4.5 C13.7 4.5 15 6 15 8', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
		else if name === 'payments'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				rect(x='3', y='6', width='18', height='12', rx='2', stroke='currentColor', stroke-width='1.75')
				path(d='M3 10 H21', stroke='currentColor', stroke-width='1.75')
				path(d='M7 15 H11', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
		else if name === 'apps'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				rect(x='4', y='4', width='6', height='6', rx='1.2', stroke='currentColor', stroke-width='1.75')
				rect(x='14', y='4', width='6', height='6', rx='1.2', stroke='currentColor', stroke-width='1.75')
				rect(x='4', y='14', width='6', height='6', rx='1.2', stroke='currentColor', stroke-width='1.75')
				rect(x='14', y='14', width='6', height='6', rx='1.2', stroke='currentColor', stroke-width='1.75')
		else if name === 'chat'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				path(d='M5 6 H19 A2 2 0 0 1 21 8 V15 A2 2 0 0 1 19 17 H10 L6 20.5 V17 H5 A2 2 0 0 1 3 15 V8 A2 2 0 0 1 5 6 Z', stroke='currentColor', stroke-width='1.75', stroke-linejoin='round')
		else if name === 'flow'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				circle(cx='6', cy='6', r='2.25', stroke='currentColor', stroke-width='1.75')
				circle(cx='18', cy='12', r='2.25', stroke='currentColor', stroke-width='1.75')
				circle(cx='6', cy='18', r='2.25', stroke='currentColor', stroke-width='1.75')
				path(d='M8.2 7.4 L15.8 11', stroke='currentColor', stroke-width='1.75')
				path(d='M15.8 13 L8.2 16.6', stroke='currentColor', stroke-width='1.75')
		else if name === 'data'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				circle(cx='12', cy='5.5', r='2.25', stroke='currentColor', stroke-width='1.75')
				circle(cx='5.5', cy='18', r='2.25', stroke='currentColor', stroke-width='1.75')
				circle(cx='18.5', cy='18', r='2.25', stroke='currentColor', stroke-width='1.75')
				path(d='M12 7.8 V11 L7.3 16.2', stroke='currentColor', stroke-width='1.75', stroke-linejoin='round')
				path(d='M12 11 L16.7 16.2', stroke='currentColor', stroke-width='1.75', stroke-linejoin='round')
		else if name === 'laptop'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				rect(x='5', y='5', width='14', height='10', rx='1.5', stroke='currentColor', stroke-width='1.75')
				path(d='M3 19 H21', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
				path(d='M8 15 H16', stroke='currentColor', stroke-width='1.75')
		else if name === 'people'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				circle(cx='9', cy='8', r='2.4', stroke='currentColor', stroke-width='1.75')
				circle(cx='16', cy='8.5', r='2', stroke='currentColor', stroke-width='1.75')
				path(d='M4.5 18 C4.5 14.8 6.4 13.2 9 13.2 C11.6 13.2 13.5 14.8 13.5 18', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
				path(d='M14 13.6 C15.7 13.4 17.6 14.6 17.6 17.4', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
		else if name === 'wrench'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				path(d='M14.5 6.5 L17.5 9.5 L10 17 H7 V14 Z', stroke='currentColor', stroke-width='1.75', stroke-linejoin='round')
				path(d='M16 5 C17.8 3.2 20.8 3.2 22 5 C20.8 6.2 19.2 6.2 18 5.5', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
		else if name === 'talent'
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				circle(cx='10', cy='8', r='2.5', stroke='currentColor', stroke-width='1.75')
				path(d='M4.5 18.5 C4.5 15 6.8 13.2 10 13.2 C13.2 13.2 15.5 15 15.5 18.5', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
				path(d='M18 10 V16', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
				path(d='M15 13 H21', stroke='currentColor', stroke-width='1.75', stroke-linecap='round')
		else
			svg(viewBox='0 0 24 24', fill='none', xmlns='http://www.w3.org/2000/svg')
				circle(cx='12', cy='12', r='3', stroke='currentColor', stroke-width='1.75')

section(class='services', id='servicios', data-article-grid='')
	div(class='main-container services__shell')
		div(class='container services__container')
			header(class='services__header')
				p(class='services__eyebrow', data-i18n='services.eyebrow')= servicesData.es.eyebrow
				h2(class='services__title', data-i18n='services.title')= servicesData.es.title
				p(class='services__lead', data-i18n='services.lead')= servicesData.es.lead

			div(class='swiper services__slider')
				div(class='swiper-wrapper services__track')
					each group, groupIndex in servicesData.es.groups
						article(class=`swiper-slide services__card services__card--${group.icon}`)
							div(class='services__icon', aria-hidden='true')
								if group.icon === 'presence'
									svg(viewBox='0 0 48 48', fill='none', xmlns='http://www.w3.org/2000/svg')
										rect(x='6', y='10', width='36', height='26', rx='4', stroke='currentColor', stroke-width='2')
										path(d='M6 18 H42', stroke='currentColor', stroke-width='2')
										circle(cx='12', cy='14', r='1.5', fill='currentColor')
										circle(cx='18', cy='14', r='1.5', fill='currentColor')
										path(d='M16 28 H32', stroke='currentColor', stroke-width='2', stroke-linecap='round')
								else if group.icon === 'automation'
									svg(viewBox='0 0 48 48', fill='none', xmlns='http://www.w3.org/2000/svg')
										circle(cx='14', cy='16', r='5', stroke='currentColor', stroke-width='2')
										circle(cx='34', cy='16', r='5', stroke='currentColor', stroke-width='2')
										circle(cx='24', cy='34', r='5', stroke='currentColor', stroke-width='2')
										path(d='M18.5 18.5 L21.5 30.5', stroke='currentColor', stroke-width='2')
										path(d='M29.5 18.5 L26.5 30.5', stroke='currentColor', stroke-width='2')
								else
									svg(viewBox='0 0 48 48', fill='none', xmlns='http://www.w3.org/2000/svg')
										circle(cx='18', cy='16', r='5', stroke='currentColor', stroke-width='2')
										circle(cx='30', cy='16', r='5', stroke='currentColor', stroke-width='2')
										path(d='M10 34 C10 28 14 26 18 26 C22 26 26 28 26 34', stroke='currentColor', stroke-width='2', stroke-linecap='round')
										path(d='M22 34 C22 28 26 26 30 26 C34 26 38 28 38 34', stroke='currentColor', stroke-width='2', stroke-linecap='round')
							h3(
								class='services__card-title',
								id=`services-title-${groupIndex}`,
								data-i18n=`services.groups.${groupIndex}.title`
							)= group.title
							ul(
								class='services__list',
								aria-labelledby=`services-title-${groupIndex}`
							)
								each item, itemIndex in group.items
									li(class='services__item')
										+servicesItemIcon(item.icon)
										strong(
											class='services__item-title',
											data-i18n=`services.groups.${groupIndex}.items.${itemIndex}.title`
										)= item.title

				div(class='article-grid-slider__controls services__controls')
					div(
						class='swiper-button-prev article-grid-slider__prev services__prev',
						data-i18n-aria='site.articleGrid.prevLabel',
						aria-label=siteData.es.articleGrid.prevLabel
					)
					div(class='swiper-pagination article-grid-slider__pagination services__pagination')
					div(
						class='swiper-button-next article-grid-slider__next services__next',
						data-i18n-aria='site.articleGrid.nextLabel',
						aria-label=siteData.es.articleGrid.nextLabel
					)

			div(class='services__footer')
				a(
					class='btn btn--primary services__catalog-cta',
					href=servicesData.es.catalogHref,
					title=servicesData.es.catalogCta,
					data-i18n='services.catalogCta',
					data-i18n-title='services.catalogCta'
				)= servicesData.es.catalogCta
