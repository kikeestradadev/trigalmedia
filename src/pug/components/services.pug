section(class='services', id='soluciones')
	div(class='main-container services__shell')
		div(class='container services__container')
			header(class='services__header')
				p(class='services__eyebrow', data-i18n='services.eyebrow')= servicesData.es.eyebrow
				h2(class='services__title', data-i18n='services.title')= servicesData.es.title
				p(class='services__lead', data-i18n='services.lead')= servicesData.es.lead

			ol(class='services__needs')
				each need, index in servicesData.es.needs
					li(class='services__need')
						span(class='services__need-index', aria-hidden='true')= index + 1
						h3(
							class='services__need-title',
							data-i18n=`services.needs.${index}.title`
						)= need.title

			div(class='services__areas')
				each area, index in servicesData.es.areas
					a(
						class='services__area',
						href=area.href,
						data-i18n-href=`services.areas.${index}.href`
					)
						img(
							class='services__area-image',
							src=area.image.src,
							alt=area.image.alt,
							width='1254',
							height='1254',
							loading='lazy',
							decoding='async',
							data-i18n-alt=`services.areas.${index}.image.alt`
						)
						span(class='services__area-copy')
							h3(
								class='services__area-title',
								data-i18n=`services.areas.${index}.title`
							)= area.title
							p(
								class='services__area-text',
								data-i18n=`services.areas.${index}.text`
							)= area.text
