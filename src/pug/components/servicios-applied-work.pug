section(class='servicios-applied-work')
	div(class='main-container servicios-applied-work__shell')
		div(class='container servicios-applied-work__container')
			p(
				class='servicios-applied-work__eyebrow',
				data-i18n='serviciosAppliedWork.eyebrow'
			)= serviciosAppliedWorkData.es.eyebrow
			h2(
				class='servicios-applied-work__title',
				data-i18n='serviciosAppliedWork.title'
			)= serviciosAppliedWorkData.es.title
			p(
				class='servicios-applied-work__text',
				data-i18n='serviciosAppliedWork.text'
			)= serviciosAppliedWorkData.es.text
			a(
				class='btn btn--primary',
				href=serviciosAppliedWorkData.es.ctaHref,
				title=serviciosAppliedWorkData.es.cta,
				data-i18n='serviciosAppliedWork.cta',
				data-i18n-title='serviciosAppliedWork.cta'
			)= serviciosAppliedWorkData.es.cta
