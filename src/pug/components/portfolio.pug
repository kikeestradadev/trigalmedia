section(class='portfolio', id='portafolio', data-article-grid='')
	div(class='main-container portfolio__shell')
		div(class='container portfolio__container')
			header(class='portfolio__header')
				p(class='portfolio__eyebrow', data-i18n='portfolio.eyebrow')= portfolioData.es.eyebrow
				h2(class='portfolio__title', data-i18n='portfolio.title')= portfolioData.es.title

			div(class='swiper portfolio__slider')
				div(class='swiper-wrapper portfolio__track')
					each sourceIndex, slideIndex in portfolioData.featured
						- var item = portfolioData.es.items[sourceIndex]
						article(class='swiper-slide portfolio__card')
							a(
								class='portfolio__card-link',
								href=item.href,
								target='_blank',
								rel='noopener noreferrer',
								title=item.name
							)
								div(class='portfolio__visual')
									img(
										class='portfolio__image',
										src=`${portfolioData.imageBase}${item.image}`,
										alt=item.imageAlt,
										width='640',
										height='400',
										loading=slideIndex < 2 ? 'eager' : 'lazy',
										decoding='async',
										data-i18n-alt=`portfolio.items.${sourceIndex}.imageAlt`
									)
								div(class='portfolio__body')
									p(
										class='portfolio__sector',
										data-i18n=`portfolio.items.${sourceIndex}.sector`
									)= item.sector
									h3(class='portfolio__name')= item.name
									dl(class='portfolio__facts')
										div(class='portfolio__fact')
											dt(
												class='portfolio__fact-label',
												data-i18n='portfolio.homeLabels.need'
											)= portfolioData.es.homeLabels.need
											dd(
												class='portfolio__fact-text',
												data-i18n=`portfolio.items.${sourceIndex}.need`
											)= item.need
										div(class='portfolio__fact')
											dt(
												class='portfolio__fact-label',
												data-i18n='portfolio.homeLabels.solution'
											)= portfolioData.es.homeLabels.solution
											dd(
												class='portfolio__fact-text',
												data-i18n=`portfolio.items.${sourceIndex}.solution`
											)= item.solution
										div(class='portfolio__fact')
											dt(
												class='portfolio__fact-label',
												data-i18n='portfolio.homeLabels.benefit'
											)= portfolioData.es.homeLabels.benefit
											dd(
												class='portfolio__fact-text',
												data-i18n=`portfolio.items.${sourceIndex}.benefit`
											)= item.benefit
									span(
										class='btn btn--outline btn--small portfolio__cta',
										data-i18n='portfolio.visitLabel'
									)= portfolioData.es.visitLabel

				div(class='article-grid-slider__controls portfolio__controls')
					div(
						class='swiper-button-prev article-grid-slider__prev portfolio__prev',
						data-i18n-aria='site.articleGrid.prevLabel',
						aria-label=siteData.es.articleGrid.prevLabel
					)
					div(class='swiper-pagination article-grid-slider__pagination portfolio__pagination')
					div(
						class='swiper-button-next article-grid-slider__next portfolio__next',
						data-i18n-aria='site.articleGrid.nextLabel',
						aria-label=siteData.es.articleGrid.nextLabel
					)

			div(class='portfolio__footer')
				a(
					class='btn btn--primary',
					href=portfolioData.es.moreHref,
					title=portfolioData.es.moreCta,
					data-i18n='portfolio.moreCta',
					data-i18n-title='portfolio.moreCta',
					data-i18n-href='portfolio.moreHref'
				)= portfolioData.es.moreCta
