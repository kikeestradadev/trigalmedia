section(class='alliances', id='alianzas')
	div(class='main-container alliances__shell')
		div(class='container alliances__container')
			div(class='alliances__copy')
				p(class='alliances__eyebrow', data-i18n='alliances.eyebrow')= alliancesData.es.eyebrow
				h2(class='alliances__title', data-i18n='alliances.title')= alliancesData.es.title
				p(class='alliances__lead', data-i18n='alliances.lead')= alliancesData.es.lead
				p(class='alliances__highlight', data-i18n='alliances.highlight')= alliancesData.es.highlight
				a(
					class='btn btn--gold alliances__cta',
					href=alliancesData.es.ctaHref,
					target='_blank',
					rel='noopener noreferrer',
					title=alliancesData.es.cta,
					data-i18n='alliances.cta',
					data-i18n-title='alliances.cta',
					data-i18n-href='alliances.ctaHref'
				)= alliancesData.es.cta

			div(class='alliances__visual', aria-hidden='true')
				div(class='alliances__orb alliances__orb--cyan')
				div(class='alliances__orb alliances__orb--gold')
				div(class='alliances__orb alliances__orb--teal')
				svg(
					class='alliances__diagram',
					viewBox='0 0 480 360',
					fill='none',
					xmlns='http://www.w3.org/2000/svg',
					focusable='false'
				)
					title(data-i18n='alliances.visualLabel')= alliancesData.es.visualLabel
					path(
						d='M86 248 C 150 248, 168 168, 240 150 C 312 132, 338 88, 394 72',
						stroke='#00c3da',
						stroke-opacity='0.55',
						stroke-width='2'
					)
					path(
						d='M110 278 C 186 250, 214 210, 268 188 C 322 166, 360 128, 404 118',
						stroke='#025765',
						stroke-width='6'
					)
					path(
						d='M132 210 C 188 196, 228 176, 276 128',
						stroke='#fcbe38',
						stroke-opacity='0.85',
						stroke-width='2'
					)
					circle(cx='86', cy='248', r='10', fill='#00c3da')
					circle(cx='132', cy='210', r='7', fill='#fcbe38')
					circle(cx='240', cy='150', r='12', fill='#021220', stroke='#00c3da', stroke-width='2')
					circle(cx='276', cy='128', r='6', fill='#00c3da')
