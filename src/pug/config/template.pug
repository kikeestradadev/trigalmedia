block config
	- let currentPage = 'home';
	- let content = 'My Page';
	- let siteName = 'Trigal Media';
	- let pageTitle = '';
	- let pageDescription = '';
	- let pageKeywords = '';
	- let pageRobots = 'index, follow';
-
	var seoLocale = siteData.es
	var seoTitle = pageTitle || seoLocale.meta.title
	var seoDescription = pageDescription || seoLocale.meta.description
	var seoKeywords = pageKeywords || seoLocale.meta.keywords
	var seoSiteName = seoLocale.meta.siteName
	var seoCanonical = siteData.siteUrl + '/'
	var seoOgImageAlt = seoLocale.meta.ogImageAlt
	var seoOgLocale = seoLocale.meta.ogLocale
	var seoOgLocaleAlternate = seoLocale.meta.ogLocaleAlternate
doctype html
html(lang='es-CR', prefix='og: http://ogp.me/ns#', class='no-js')
	head
		meta(charset='utf-8')
		meta(name='viewport', content='width=device-width, initial-scale=1.0')
		meta(name='format-detection', content='telephone=no')
		meta(name='theme-color', content='#021220')
		meta(name='author', content=siteData.author)
		meta(name='geo.region', content='CR')
		meta(name='geo.placename', content='Costa Rica')
		meta(name='robots', content=pageRobots)
		link(rel='icon', href='./assets/favico.ico', sizes='any')
		link(rel='icon', href='./assets/favico.png', type='image/png')
		link(rel='apple-touch-icon', href='./assets/favico.png')
		title= seoTitle
		meta(name='description', content=seoDescription)
		meta(name='keywords', content=seoKeywords)
		link(rel='canonical', href=seoCanonical)
		link(rel='alternate', hreflang='es', href=seoCanonical)
		link(rel='alternate', hreflang='en', href=seoCanonical)
		link(rel='alternate', hreflang='x-default', href=seoCanonical)
		include open-graph
		include twitter-cards
		include structured-data
		link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css')
		link(rel='preconnect', href='https://fonts.googleapis.com')
		link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
		link(
			href='https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap',
			rel='stylesheet'
		)
		link(rel='stylesheet', href=`./assets/prism.css?v=${assetVersion}`)
		link(rel='stylesheet', href=`styles.css?v=${assetVersion}`)
	body(class=currentPage, itemscope, itemtype='http://schema.org/WebPage')
		a(class='skip-link', href='#contenido', data-i18n='site.skip')= siteData.es.skip
		header(class='main-header')
			block main-header
		main(id='contenido')
			block main-container
		footer(class='main-footer')
			block main-footer
		block after-footer
		script(src='https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js')
		block data
		script(src=`index.js?v=${assetVersion}`)
		block scripts
