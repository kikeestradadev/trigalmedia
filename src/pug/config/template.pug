block config
	- let currentPage = 'home';
	- let content = 'My Page';
	- let siteName = 'Trigal Media';
	- let pageTitle = '';
	- let pageDescription = 'Trigal Media es tu socio tecnológico.';
doctype html
html(lang='es', prefix='og: http://ogp.me/ns#', class='no-js')
	head
		meta(charset='utf-8')
		meta(name='viewport', content='width=device-width, initial-scale=1.0')
		meta(name='format-detection', content='telephone=no')
		meta(name='theme-color', content='#021220')
		link(rel='icon', href='./assets/favico.ico', sizes='any')
		link(rel='icon', href='./assets/favico.png', type='image/png')
		link(rel='apple-touch-icon', href='./assets/favico.png')
		meta(name='description', content=pageDescription)
		meta(name='robots', content='index, follow')
		link(rel='canonical', href='https://kikeestradadev.github.io/trigalmedia/')
		include open-graph
		include twitter-cards
		link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css')
		link(rel='preconnect', href='https://fonts.googleapis.com')
		link(rel='preconnect', href='https://fonts.gstatic.com', crossorigin)
		link(
			href='https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap',
			rel='stylesheet'
		)
		link(rel='stylesheet', href=`./assets/prism.css?v=${assetVersion}`)
		link(rel='stylesheet', href=`styles.css?v=${assetVersion}`)
		title= pageTitle || (currentPage.slice(0, 1).toUpperCase() + currentPage.slice(1) + ' | ' + siteName)
	body(class=currentPage, itemscope, itemtype='http://schema.org/WebPage')
		a(class='skip-link', href='#contenido', data-i18n='site.skip')= siteData.es.skip
		header(class='main-header')
			block main-header
		main(id='contenido')
			block main-container
		footer(class='main-footer')
			block main-footer
		block after-footer
		script(src='https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js')
		block data
		script(src=`index.js?v=${assetVersion}`)
		block scripts
